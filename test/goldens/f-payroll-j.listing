                                *PROCEDURE
                 126,00   71371 GN)000CALL (MASTER EMPLOYEE.NUMBER)   M.EMPLOYNO,
                          71372            (DETAIL EMPLOYEE.NUMBER)   D.EMPLOYNO,
                          71373            (MASTER BONDEDUCTION)      M.BONDEDUCT,
                          71374            (MASTER BONDENOMINATION)   M.BONDENOM,
                          71375            (MASTER BONDACCUMULATION)  M.BONDACCUM.
                 127,00   71376 START.  OPEN ALL FILES.
                 128,00   71377 GET.MASTER.  GET MASTER, AT END DO END.OF.MASTERS.
                 129,00   71402 GET.DETAIL.  GET DETAIL, AT END GO TO END.OF.DETAILS.
                 130,00   71405 COMPARE.EMPLOYEE.NUMBERS.  GO TO COMPUTE.PAY WHEN D.EMPLOYNO
                                      IS EQUAL TO M.EMPLOYNO, LOW.DETAIL WHEN
                                      D.EMPLOYNO IS LESS THAN M.EMPLOYNO.
                 131,00   71406 HIGH.DETAIL.  MOVE 'M' TO MASTER ERRORCODE, FILE MASTER IN
                                      ERROR.FILE.
                 132,00                 GET MASTER, AT END DO END.OF.MASTERS.
                 133,00                 GO TO COMPARE.EMPLOYEE.NUMBERS.
                 134,00   71411 LOW.DETAIL.  MOVE 'D' TO DETAIL ERRORCODE, FILE DETAIL IN
                                      ERROR.FILE.
                 135,00                 GO TO GET.DETAIL.
                 136,00   71412 END.OF.MASTERS.  IF D.EMPLOYNO = HIGH.VALUE THEN GO TO
                                      END.OF.RUN OTHERWISE SET M.EMPLOYNO = HIGH.VALUE.
                 137,00   71415 END.OF.DETAILS.  IF M.EMPLOYNO = HIGH.VALUE THEN GO TO
                                      END.OF.RUN OTHERWISE SET D.EMPLOYNO = HIGH.VALUE, GO
                                      TO COMPARE.EMPLOYEE.NUMBERS.
                 138,00   71420 END.OF.RUN.  MOVE CORRESPONDING GRAND.TOTAL TO PAYRECORD, FILE
                                      PAYRECORD, CLOSE ALL FILES.
                 139,00                 STOP RUN.
                 140,00   71421 COMPUTE.PAY.  IF DETAIL HOURS IS GREATER THAN 40 THEN SET DETAIL
                                      GROSS = (DETAIL HOURS - 40) * MASTER RATE * 1.5.
        DATE 06/01/60  TIME  1.00  ACCOUNT                     ID.                         PAGE  4

                 141,00                 SET DETAIL GROSS = DETAIL GROSS + MASTER RATE * 40, DO
                                      FICA.ROUTINE, DO WITHOLDING.TAX.ROUTINE.
                 142,00                 IF M.BONDEDUCT IS NOT EQUAL TO ZERO THEN DO
                                      BOND.ROUTINE.
                 143,00                 DO SEARCH FOR INDEX = 1(1)12.
                 144,00   71424 NET.    SET PAYRECORD NETPAY = DETAIL GROSS - DETAIL FICA - DETAIL
                                      WHT - DETAIL RETIREMENT - DETAIL INSURANCE - DETAIL
                                      BONDEDUCTION.
                 145,00                 ADD CORRESPONDING DETAIL TOTALS TO MASTER TOTALS, MOVE
                                      CORRESPONDING DETAIL TO PAYRECORD, CHECK, MOVE PAYRECORD
                                      NETPAY TO CHECK AMOUNT.
                 146,00                 FILE CHECK.
                 147,00                 IF PAYRECORD DEPARTMENT IS GREATER THAN CURRENT DEPARTMENT
                                      THEN MOVE BLANKS TO PAYRECORD EMPLOYEE.NUMBER, PAYRECORD
                                      NAME, MOVE CORRESPONDING DEPARTMENT.TOTAL TO PAYRECORD, FILE
                                      PAYRECORD, MOVE ZEROS TO DEPARTMENT.TOTAL HOURS,
                                      DEPARTMENT.TOTAL GROSS, DEPARTMENT.TOTAL WHT,
                                      DEPARTMENT.TOTAL FICA, DEPARTMENT.TOTAL BONDEDUCTION,
                                      DEPARTMENT.TOTAL INSURANCE.PREM, DEPARTMENT.TOTAL
                                      RETIREMENT.PREM, DEPARTMENT.TOTAL NETPAY, DEPARTMENT.TOTAL
                                      BONDPURCHASES.
                 148,00                 MOVE CORRESPONDING DETAIL TO PAYRECORD, CURRENT,  ADD
                                      CORRESPONDING DETAIL TO DEPARTMENT.TOTAL, GRAND.TOTAL,
                                      FILE PAYRECORD.
                 149,00                 GO TO GET.MASTER.
                 150,00   71426 FICA.ROUTINE.  BEGIN SECTION.
                 151,00                 IF MASTER FICA + 0.03 * DETAIL GROSS IS LESS THAN 144.00
                                      THEN SET DETAIL FICA = 0.03 * DETAIL GROSS  OTHERWISE SET
                                      DETAIL FICA = 144.00 - MASTER FICA.
                 152,00                 ADD DETAIL FICA TO MASTER FICA.
                 153,00         GN)030END FICA.ROUTINE.
                 154,00   71432 WITHOLDING.TAX.ROUTINE.  BEGIN SECTION.
                 155,00                 IF 13 * MASTER EXEMPTIONS IS LESS THAN DETAIL GROSS THEN
                                      SET DETAIL WHT = 0.18 * (DETAIL GROSS - 13 * MASTER
                                      EXEMPTIONS) OTHERWISE SET DETAIL WHT = ZEROS.
                 156,00                 ADD DETAIL WHT TO MASTER WHT.
                 157,00         GN)033END WITHOLDING.TAX.ROUTINE.
                 158,00   71436 BOND.ROUTINE.  BEGIN SECTION.
                 159,00                 ADD M.BONDEDUCT TO M.BONDACCUM.
                 160,00   71437 BOND.CALCULATION.  IF M.BONDENOM IS NOT GREATER THAN
                                      M.BONDACCUM THEN SET M.BONDACCUM = M.BONDACCUM -
                                      M.BONDENOM OTHERWISE GO TO BOND.END.
                 161,00                 MOVE CORRESPONDING MASTER TO BONDORDER, ADD BONDORDER
                                      BONDENOMINATION TO DEPARTMENT.TOTAL BONDPURCHASES, MOVE
                                      BONDORDER BONDENOMINATION TO PAYRECORD BONDENOMINATION, FILE
                                      BONDORDER IN ERROR.FILE.
                 162,00                 GO TO BOND.CALCULATION.
                 163,00   71442 BOND.END.  END BOND.ROUTINE.
                 164,00   71443 SEARCH.  BEGIN SECTION.
                 165,00                 IF MASTER RATE GT TABLE.ITEM RATE (INDEX) THEN GO TO
                                      SEARCH.END OTHERWISE ADD TABLE.ITEM INSURANCE.PREM (INDEX)
                                      TO DETAIL INSURANCE, ADD TABLE.ITEM RETIREMENT.PREM (INDEX)
                                      TO DETAIL RETIREMENT, GO TO NET.
                 166,00   71446 SEARCH.END.  END SEARCH.

