procedure-group
  187,00 sentence
    187,01 call-clause
      call-pair new M.EMP.NO
        old name MASTER EMPLOYEE.NUMBER
      call-pair new D.EMP.NO
        old name DETAIL EMPLOYEE.NUMBER
      call-pair new D.DEPT
        old name DETAIL DEPARTMENT
      call-pair new M.BND.DED
        old name MASTER BONDEDUCTION
      call-pair new M.BND.ACC
        old name MASTER BONDACCUMULATION
  188,00 sentence label START
    188,01 open-clause all-files
    188,02 move-clause
      source figurative ZEROS
      target name INTERNAL.TOTALS
      target name GRAND.TOTALS
    188,03 get-clause
      record name MASTER
      at-end-clause
        188,04 do-clause
          procedure name END.OF.MASTERS
  189,00 sentence
    189,01 move-clause
      source name MASTER DEPARTMENT
      target name CURRENT.DEPT
    189,02 go-to-clause
      target name GET.DETAIL
  190,00 sentence label GET.MASTER
    190,01 get-clause
      record name MASTER
      at-end-clause
        190,02 do-clause
          procedure name END.OF.MASTERS
  191,00 sentence label GET.DETAIL
    191,01 get-clause
      record name DETAIL
      at-end-clause
        191,02 go-to-clause
          target name END.OF.DETAILS
  192,00 sentence label COMPARE.EMPLOYEE.NUMBERS
    192,01 go-to-clause
      target name CHECK.NEW.DEPT
        when comparison EQUAL
          name D.EMP.NO
          name M.EMP.NO
      target name LOW.DETAIL
        when comparison LESS
          name D.EMP.NO
          name M.EMP.NO
  193,00 sentence label HIGH.DETAIL
    193,01 move-clause
      source literal 'M'
      target name ERRORTYPE
    193,02 move-clause
      source name MASTER DAT
      target name ERROROUT INFO
    193,03 file-clause
      record name ERROROUT
  194,00 sentence
    194,01 get-clause
      record name MASTER
      at-end-clause
        194,02 do-clause
          procedure name END.OF.MASTERS
  195,00 sentence
    195,01 go-to-clause
      target name COMPARE.EMPLOYEE.NUMBERS
  196,00 sentence label LOW.DETAIL
    196,01 move-clause
      source name DETAIL
      target name ERROROUT INFO
    196,02 move-clause
      source literal 'D'
      target name ERRORTYPE
    196,03 file-clause
      record name ERROROUT
    196,04 go-to-clause
      target name GET.DETAIL
  197,00 sentence label END.OF.MASTERS
    197,01 if-clause
      comparison EQUAL
        name D.EMP.NO
        figurative HIGH.VALUE
      197,02 then go-to-clause
        target name END.OF.RUN
      197,03 otherwise set-clause
        target name M.EMP.NO
        value figurative HIGH.VALUE
  198,00 sentence label END.OF.DETAILS
    198,01 if-clause
      comparison EQUAL
        name M.EMP.NO
        figurative HIGH.VALUE
      198,02 then go-to-clause
        target name END.OF.RUN
      198,03 otherwise set-clause
        target name D.EMP.NO
        value figurative HIGH.VALUE
      198,04 otherwise go-to-clause
        target name HIGH.DETAIL
  199,00 sentence label END.OF.RUN
    199,01 do-clause
      procedure name DEPARTMENT.END
    199,02 move-clause corresponding
      source name GRAND.TOTALS
      target name PAYRECORD
    199,03 move-clause
      source name GRAND.TOTALS HOURS
      target name PAYRECORD HRS
    199,04 move-clause
      source name GRAND.TOTALS INSURANCE
      target name PAYRECORD INS.PREM
    199,05 move-clause
      source name GRAND.TOTALS RETIREMENT
      target name PAYRECORD RET.PREM
    199,06 move-clause
      source literal 'GT'
      target name PAYRECORD DEPARTMENT
    199,07 move-clause
      source figurative BLANKS
      target name PAYRECORD NAME
      target name PAYRECORD EMPLOYEE
      target name PAYRECORD MONTH
      target name PAYRECORD DAY
      target name PAYRECORD YEAR
    199,08 move-clause
      source name GRAND.TOTALS BONDPURCHASES
      target name PAYRECORD BONDENOMINATION
    199,09 file-clause
      record name PAYRECORD
    199,10 close-clause all-files
    199,11 stop-clause RUN
  200,00 sentence label CHECK.NEW.DEPT
    200,01 if-clause
      comparison NOT EQUAL
        name CURRENT.DEPT
        name D.DEPT
      200,02 then do-clause
        procedure name DEPARTMENT.END
      200,03 otherwise go-to-clause
        target name COMPUTE.PAY
  201,00 sentence
    201,01 move-clause
      source figurative ZEROS
      target name INTERNAL.TOTALS
    201,02 move-clause
      source name D.DEPT
      target name CURRENT.DEPT
  202,00 sentence label COMPUTE.PAY
    202,01 move-clause
      source name DETAIL DATE
      target name MASTER DATE
    202,02 move-clause
      source name DETAIL HOURS
      target name WORKING HOURS
      target name PAYRECORD HRS
  203,00 sentence
    203,01 if-clause
      comparison GREATER
        name WORKING HOURS
        literal 40.0
      203,02 then set-clause
        target name WORKING GROSS
        value binary *
          binary -
            binary *
              name WORKING HOURS
              literal 1.5
            literal 20
          name MASTER RATE
      203,03 otherwise set-clause
        target name WORKING GROSS
        value binary *
          name WORKING HOURS
          name MASTER RATE
  204,00 sentence
    204,01 do-clause
      procedure name FICA.ROUTINE
    204,02 do-clause
      procedure name WITHOLDING.TAX.ROUTINE
  205,00 sentence
    205,01 if-clause
      comparison NOT EQUAL
        name M.BND.DED
        figurative ZERO
      205,02 then do-clause
        procedure name BOND.ROUTINE
      205,03 otherwise move-clause
        source figurative BLANKS
        target name PAYRECORD BONDEDUCTION
        target name PAYRECORD BONDENOMINATION
  206,00 sentence
    206,01 do-clause
      procedure name SEARCH
      for name INDEX
        from literal 1
        by literal 1
        to literal 12
  207,00 sentence label NET
    207,01 set-clause
      target name WORKING NETPAY
      value binary -
        binary -
          binary -
            binary -
              binary -
                name WORKING GROSS
                name WORKING FICA
              name WORKING WHT
            name WORKING RETIREMENT
          name WORKING INSURANCE
        name M.BND.DED
  208,00 sentence
    208,01 add-clause corresponding
      source name WORKING
      target name MASTER TOTALS
      target name INTERNAL.TOTALS
    208,02 move-clause corresponding
      source name DETAIL
      target name PAYRECORD
      target name CHECK
    208,03 move-clause corresponding
      source name WORKING
      target name PAYRECORD
    208,04 move-clause
      source name MASTER NAME
      target name PAYRECORD NAME
      target name CHECK NAME
    208,05 move-clause
      source name WORKING NETPAY
      target name CHECK AMOUNT
    208,06 file-clause
      record name CHECK
    208,07 file-clause
      record name PAYRECORD
    208,08 file-clause
      record name MASTER
  209,00 sentence
    209,01 go-to-clause
      target name GET.MASTER
  210,00 sentence label FICA.ROUTINE
    210,01 begin-section-clause
  211,00 sentence
    211,01 set-clause
      target name WORKING FICA
      value binary *
        literal .03
        name WORKING GROSS
    211,02 add-clause
      source name WORKING FICA
      target name MASTER FICA
  212,00 sentence
    212,01 if-clause
      comparison GREATER
        name MASTER FICA
        literal 144.00
      212,02 then set-clause
        target name WORKING FICA
        value binary -
          name WORKING FICA
          binary -
            name MASTER FICA
            literal 144.00
      212,03 then set-clause
        target name MASTER FICA
        value literal 144.00
  213,00 sentence
    213,01 end-clause
      name FICA.ROUTINE
  214,00 sentence label WITHOLDING.TAX.ROUTINE
    214,01 begin-section-clause
  215,00 sentence
    215,01 set-clause
      target name WORKING WHT
      value binary *
        literal 0.18
        binary -
          name WORKING GROSS
          binary *
            literal 13
            name MASTER EXEMPTIONS
    215,02 set-clause
      target name WORKING WHT
      value binary *
        name WORKING WHT
        truth
          comparison GREATER
            name WORKING WHT
            literal 0
    215,03 add-clause
      source name WORKING WHT
      target name MASTER WHT
  216,00 sentence
    216,01 end-clause
      name WITHOLDING.TAX.ROUTINE
  217,00 sentence label BOND.ROUTINE
    217,01 begin-section-clause
  218,00 sentence
    218,01 add-clause
      source name M.BND.DED
      target name M.BND.ACC
      target name INTERNAL.TOTALS BONDEDUCTION
  219,00 sentence
    219,01 move-clause
      source name M.BND.DED
      target name PAYRECORD BONDEDUCTION
  220,00 sentence
    220,01 if-clause
      comparison NOT GREATER
        name MASTER BONDENOMINATION
        name M.BND.ACC
      220,02 then set-clause
        target name M.BND.ACC
        value binary -
          name M.BND.ACC
          name MASTER BONDENOMINATION
      220,03 otherwise move-clause
        source figurative BLANKS
        target name PAYRECORD BONDENOMINATION
      220,04 otherwise go-to-clause
        target name BOND.END
  221,00 sentence
    221,01 move-clause corresponding
      source name MASTER
      target name BONDORDER
    221,02 add-clause
      source name BONDORDER BONDENOMINATION
      target name INTERNAL.TOTALS BONDPURCHASES
    221,03 move-clause
      source name BONDORDER BONDENOMINATION
      target name PAYRECORD BONDENOMINATION
  222,00 sentence
    222,01 file-clause
      record name BONDORDER
  223,00 sentence label BOND.END
    223,01 end-clause
      name BOND.ROUTINE
  224,00 sentence label SEARCH
    224,01 begin-section-clause
  225,00 sentence
    225,01 if-clause
      comparison GREATER
        name MASTER RATE
        name TABLE.ITEM RATE
          subscript name INDEX
      225,02 then go-to-clause
        target name SEARCH.END
      225,03 otherwise move-clause
        source name INDEX
        target name POS
      225,04 otherwise move-clause
        source name INSPREM
          subscript name POS
        target name INS.PREM
        target name WORKING INSURANCE
      225,05 otherwise move-clause
        source name RETPREM
          subscript name POS
        target name RET.PREM
        target name WORKING RETIREMENT
      225,06 otherwise go-to-clause
        target name NET
  226,00 sentence label SEARCH.END
    226,01 end-clause
      name SEARCH
  227,00 sentence label DEPARTMENT.END
    227,01 begin-section-clause
  228,00 sentence
    228,01 move-clause corresponding
      source name INTERNAL.TOTALS
      target name DEPARTMENT.TOTAL
    228,02 file-clause
      record name DEPARTMENT.TOTAL
    228,03 add-clause corresponding
      source name INTERNAL.TOTALS
      target name GRAND.TOTALS
  229,00 sentence
    229,01 end-clause
      name DEPARTMENT.END
