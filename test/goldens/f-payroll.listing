        01001                   *PROCEDURE
        01002      1,00   71176 GN)000CALL (EMPLOYEE.NUMBER)  EMPLOYNO,
        01003             71177            (BONDEDUCTION)     BONDEDUCT,
        01004             71200            (BONDENOMINATION)  BONDENOM,
        01005             71201            (BONDACCUMULATION) BONDACCUM,
