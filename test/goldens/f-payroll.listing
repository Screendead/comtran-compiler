        DATE 06/01/60  TIME  1.00  ACCOUNT                     ID.                         PAGE  1


        *COMPILE LIST
  CTC

                                *PROCEDURE
                   1,00   71176 GN)000CALL (EMPLOYEE.NUMBER)     EMPLOYNO,
                          71177            (BONDEDUCTION)        BONDEDUCT,
                          71200            (BONDENOMINATION)     BONDENOM,
                          71201            (BONDACCUMULATION)    BONDACCUM,
                          71202            (INSURANCE.PREM)      INSPREM,
                          71203            (RETIREMENT.PREM)     RETPREM,
                          71204            (DEPARTMENT.TOTAL)    DPT.
                   2,00   71205 START.  OPEN ALL FILES.
                   3,00   71206 GET.MASTER.  GET MASTER, AT END DO END.OF.MASTERS.
                   4,00   71211 GET.DETAIL.  GET DETAIL, AT END GO TO END.OF.DETAILS.
                   5,00   71214 COMPARE.EMPLOYEE.NUMBERS.  GO TO COMPUTE.PAY WHEN DETAIL EMPLOYNO
                                      IS EQUAL TO MASTER EMPLOYNO, LOW.DETAIL WHEN DETAIL
                                      EMPLOYNO IS LESS THAN MASTER EMPLOYNO.
                   6,00   71215 HIGH.DETAIL.  MOVE 'M' TO MASTER ERRORCODE, FILE MASTER IN
                                      ERROR.FILE.
                   7,00                 GET MASTER, AT END DO END.OF.MASTERS.
                   8,00                 GO TO COMPARE.EMPLOYEE.NUMBERS.
                   9,00   71220 LOW.DETAIL.  MOVE 'D' TO DETAIL ERRORCODE, FILE DETAIL IN
                                      ERROR.FILE.
                  10,00                 GO TO GET.DETAIL.
                  11,00   71221 END.OF.MASTERS.  IF DETAIL EMPLOYNO = HIGH.VALUE THEN GO TO
                                      END.OF.RUN OTHERWISE SET MASTER EMPLOYNO = HIGH.VALUE.
                  12,00   71224 END.OF.DETAILS.  IF MASTER EMPLOYNO = HIGH.VALUE THEN GO TO
                                      END.OF.RUN OTHERWISE SET DETAIL EMPLOYNO = HIGH.VALUE, GO
                                      TO COMPARE.EMPLOYEE.NUMBERS.
                  13,00   71227 END.OF.RUN.  MOVE CORRESPONDING GRAND.TOTAL TO PAYRECORD, FILE
                                      PAYRECORD, CLOSE ALL FILES.
                  14,00                 STOP 1234.
                  15,00   71230 COMPUTE.PAY.  IF DETAIL HOURS IS GREATER THAN 40 THEN SET DETAIL
                                      GROSS = (DETAIL HOURS - 40) * MASTER RATE * 1.5.
                  16,00                 SET DETAIL GROSS = DETAIL GROSS + MASTER RATE * 40, DO
                                      FICA.ROUTINE, DO WITHOLDING.TAX.ROUTINE.
                  17,00                 IF MASTER BONDEDUCT IS NOT EQUAL TO ZERO THEN DO
                                      BOND.ROUTINE.
                  18,00                 DO SEARCH FOR INDEX = 1(1)12.
                  19,00   71233 NET.    SET PAYRECORD NETPAY = DETAIL GROSS - DETAIL FICA - DETAIL
                                      WHT - DETAIL RETIREMENT - DETAIL INSURANCE - DETAIL
                                      BONDEDUCT.
                  20,00                 ADD CORRESPONDING DETAIL TOTALS TO MASTER TOTALS, MOVE
                                      CORRESPONDING DETAIL TO PAYRECORD, CHECK, MOVE PAYRECORD
                                      NETPAY TO CHECK AMOUNT.
                  21,00                 FILE CHECK.
                  22,00                 IF PAYRECORD DEPARTMENT IS GREATER THAN CURRENT DEPARTMENT
                                      THEN MOVE BLANKS TO PAYRECORD EMPLOYNO, PAYRECORD NAME,
                                      MOVE CORRESPONDING DEPARTMENT.TOTAL TO PAYRECORD, FILE
                                      PAYRECORD, MOVE ZEROS TO DPT HOURS, DPT GROSS, DPT WHT,
                                      DPT FICA, DPT BONDEDUCT, DPT INSPREM, DPT RETPREM, DPT
                                      NETPAY, DPT BONDPURCHASES.
                  23,00                 MOVE CORRESPONDING DETAIL TO PAYRECORD, CURRENT,  ADD
                                      CORRESPONDING DETAIL TO DEPARTMENT.TOTAL, GRAND.TOTAL,
        DATE 06/01/60  TIME  1.00  ACCOUNT                     ID.                         PAGE  2

                                      FILE PAYRECORD.
                  24,00                 GO TO GET.MASTER.
                  25,00   71235 FICA.ROUTINE.  BEGIN SECTION.
                  26,00                 IF MASTER FICA + 0.03 * DETAIL GROSS IS LESS THAN 144.00
                                      THEN SET DETAIL FICA = 0.03 * DETAIL GROSS  OTHERWISE SET
                                      DETAIL FICA = 144.00 - MASTER FICA.
                  27,00                 ADD DETAIL FICA TO MASTER FICA.
                  28,00         GN)016END FICA.ROUTINE.
                  29,00   71241 WITHOLDING.TAX.ROUTINE.  BEGIN SECTION.
                  30,00                 IF 13 * MASTER EXEMPTIONS IS LESS THAN DETAIL GROSS THEN
                                      SET DETAIL WHT = 0.18 * (DETAIL GROSS - 13 * MASTER
                                      EXEMPTIONS) OTHERWISE SET DETAIL WHT = ZEROS.
                  31,00                 ADD DETAIL WHT TO MASTER WHT.
                  32,00         GN)019END WITHOLDING.TAX.ROUTINE.
                  33,00   71245 BOND.ROUTINE.  BEGIN SECTION.
                  34,00                 ADD MASTER BONDEDUCT TO MASTER BONDACCUM.
                  35,00   71246 BOND.CALCULATION.  IF MASTER BONDENOM IS NOT GREATER THAN MASTER
                                      BONDACCUM THEN SET MASTER BONDACCUM = MASTER BONDACCUM -
                                      MASTER BONDENOM OTHERWISE GO TO BOND.END.
                  36,00                 MOVE CORRESPONDING MASTER TO BONDORDER, ADD BONDORDER
                                      BONDENOM TO DPT BONDPURCHASES, MOVE BONDORDER BONDENOM TO
                                      PAYRECORD BONDENOM, FILE BONDORDER IN ERROR.FILE.
                  37,00                 GO TO BOND.CALCULATION.
                  38,00   71251 BOND.END.  END BOND.ROUTINE.
                  39,00   71252 SEARCH.  BEGIN SECTION.
                  40,00                 IF MASTER RATE GT TABLE.ITEM RATE (INDEX) THEN GO TO
                                      SEARCH.END OTHERWISE ADD TABLE.ITEM INSPREM (INDEX) TO
                                      DETAIL INSURANCE, ADD TABLE.ITEM RETPREM (INDEX) TO DETAIL
                                      RETIREMENT, GO TO NET.
                  41,00   71255 SEARCH.END.  END SEARCH.

