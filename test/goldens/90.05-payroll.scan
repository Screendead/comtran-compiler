*ENVIRONMENT
173,00  SPEC  INPUTMASTER FILE INPUT, BINARY, TAPE, MASTER, BLOCKSIZE 300
174,00  SPEC  SPECIF INPUTMASTER, UNIT1 'D1', OPENW, CLOSER
175,00  SPEC  OUTPUTMASTER FILE OUTPUT, BINARY, TAPE, MASTER, BLOCKSIZE 300
176,00  SPEC  SPECIF OUTPUTMASTER, UNIT1 'C1', OPENW, CLOSER
177,00  SPEC  DETAILFILE FILE INPUT, BCD, TAPE, DETAIL, BLOCKSIZE 3
178,00  SPEC  SPECIF DETAILFILE, UNIT1 'C2', OPENW, CLOSER, LOW
179,00  SPEC  CHECKFILE FILE OUTPUT, BCD, TAPE, CHECK, BLOCKSIZE 20
180,00  SPEC  SPECIF CHECKFILE, UNIT1 'D2', OPENW, CLOSER, LOW
181,00  SPEC  PAYFILE FILE OUTPUT, BCD, TAPE, PAYRECORD, DEPARTMENT.TOTAL, BLOCKSIZE 20
182,00  SPEC  SPECIF PAYFILE, UNIT1 'D3', OPENW, CLOSER, LOW
