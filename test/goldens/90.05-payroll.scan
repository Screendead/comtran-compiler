186,00  SPEC  SPECIF ERRORFILE, UNIT1 'D4', OPENW, CLOSER, LOW
*PROCEDURE
187,00  SENTENCE  CALL ( MASTER EMPLOYEE.NUMBER ) M.EMP.NO, ( DETAIL EMPLOYEE.NUMBER ) D.EMP.NO, ( DETAIL DEPARTMENT ) D.DEPT, ( MASTER BONDEDUCTION ) M.BND.DED, ( MASTER BONDACCUMULATION ) M.BND.ACC
188,00  SENTENCE  START. OPEN ALL FILES, MOVE ZEROS TO INTERNAL.TOTALS, GRAND.TOTALS, GET MASTER, AT END DO END.OF.MASTERS
189,00  SENTENCE  MOVE MASTER DEPARTMENT TO CURRENT.DEPT, GO TO GET.DETAIL
190,00  SENTENCE  GET.MASTER. GET MASTER, AT END DO END.OF.MASTERS
191,00  SENTENCE  GET.DETAIL. GET DETAIL, AT END GO TO END.OF.DETAILS
192,00  SENTENCE  COMPARE.EMPLOYEE.NUMBERS. GO TO CHECK.NEW.DEPT WHEN D.EMP.NO = M.EMP.NO, LOW.DETAIL WHEN D.EMP.NO LT M.EMP.NO
193,00  SENTENCE  HIGH.DETAIL. MOVE 'M' TO ERRORTYPE, MOVE MASTER DAT TO ERROROUT INFO, FILE ERROROUT
194,00  SENTENCE  GET MASTER, AT END DO END.OF.MASTERS
195,00  SENTENCE  GO TO COMPARE.EMPLOYEE.NUMBERS
196,00  SENTENCE  LOW.DETAIL. MOVE DETAIL TO ERROROUT INFO, MOVE 'D' TO ERRORTYPE, FILE ERROROUT, GO TO GET.DETAIL
197,00  SENTENCE  END.OF.MASTERS. IF D.EMP.NO = HIGH.VALUE THEN GO TO END.OF.RUN OTHERWISE SET M.EMP.NO = HIGH.VALUE
198,00  SENTENCE  END.OF.DETAILS. IF M.EMP.NO = HIGH.VALUE THEN GO TO END.OF.RUN OTHERWISE SET D.EMP.NO = HIGH.VALUE, GO TO HIGH.DETAIL
199,00  SENTENCE  END.OF.RUN. DO DEPARTMENT.END, MOVE CORRESPONDING GRAND.TOTALS TO PAYRECORD, MOVE GRAND.TOTALS HOURS TO PAYRECORD HRS, MOVE GRAND.TOTALS INSURANCE TO PAYRECORD INS.PREM, MOVE GRAND.TOTALS RETIREMENT TO PAYRECORD RET.PREM, MOVE 'GT' TO PAYRECORD DEPARTMENT, MOVE BLANKS TO PAYRECORD NAME, PAYRECORD EMPLOYEE, PAYRECORD MONTH, PAYRECORD DAY, PAYRECORD YEAR, MOVE GRAND.TOTALS BONDPURCHASES TO PAYRECORD BONDENOMINATION, FILE PAYRECORD, CLOSE ALL FILES, STOP RUN
200,00  SENTENCE  CHECK.NEW.DEPT. IF CURRENT.DEPT IS NOT EQUAL TO D.DEPT THEN DO DEPARTMENT.END OTHERWISE GO TO COMPUTE.PAY
201,00  SENTENCE  MOVE ZEROS TO INTERNAL.TOTALS, MOVE D.DEPT TO CURRENT.DEPT
202,00  SENTENCE  COMPUTE.PAY. MOVE DETAIL DATE TO MASTER DATE, MOVE DETAIL HOURS TO WORKING HOURS, PAYRECORD HRS
203,00  SENTENCE  IF WORKING HOURS GT 40.0 THEN SET WORKING GROSS = ( WORKING HOURS * 1.5 - 20 ) * MASTER RATE OTHERWISE SET WORKING GROSS = WORKING HOURS * MASTER RATE
204,00  SENTENCE  DO FICA.ROUTINE, DO WITHOLDING.TAX.ROUTINE
205,00  SENTENCE  IF M.BND.DED IS NOT EQUAL TO ZERO THEN DO BOND.ROUTINE OTHERWISE MOVE BLANKS TO PAYRECORD BONDEDUCTION, PAYRECORD BONDENOMINATION
206,00  SENTENCE  DO SEARCH FOR INDEX = 1 ( 1 ) 12
207,00  SENTENCE  NET. SET WORKING NETPAY = WORKING GROSS - WORKING FICA - WORKING WHT - WORKING RETIREMENT - WORKING INSURANCE - M.BND.DED
208,00  SENTENCE  ADD CORRESPONDING WORKING TO MASTER TOTALS, INTERNAL.TOTALS, MOVE CORRESPONDING DETAIL TO PAYRECORD, CHECK, MOVE CORRESPONDING WORKING TO PAYRECORD, MOVE MASTER NAME TO PAYRECORD NAME, CHECK NAME, MOVE WORKING NETPAY TO CHECK AMOUNT, FILE CHECK, FILE PAYRECORD, FILE MASTER
209,00  SENTENCE  GO TO GET.MASTER
210,00  SENTENCE  FICA.ROUTINE. BEGIN SECTION
211,00  SENTENCE  SET WORKING FICA = .03 * WORKING GROSS, ADD WORKING FICA TO MASTER FICA
212,00  SENTENCE  IF MASTER FICA GT 144.00 THEN SET WORKING FICA = WORKING FICA - ( MASTER FICA - 144.00 ), SET MASTER FICA = 144.00
213,00  SENTENCE  END FICA.ROUTINE
214,00  SENTENCE  WITHOLDING.TAX.ROUTINE. BEGIN SECTION
215,00  SENTENCE  SET WORKING WHT = 0.18 * ( WORKING GROSS - 13 * MASTER EXEMPTIONS ), SET WORKING WHT = WORKING WHT * TR ( WORKING WHT GT 0 ), ADD WORKING WHT TO MASTER WHT
216,00  SENTENCE  END WITHOLDING.TAX.ROUTINE
217,00  SENTENCE  BOND.ROUTINE. BEGIN SECTION
218,00  SENTENCE  ADD M.BND.DED TO M.BND.ACC, INTERNAL.TOTALS BONDEDUCTION
219,00  SENTENCE  MOVE M.BND.DED TO PAYRECORD BONDEDUCTION
220,00  SENTENCE  IF MASTER BONDENOMINATION NOT GT M.BND.ACC THEN SET M.BND.ACC = M.BND.ACC - MASTER BONDENOMINATION OTHERWISE MOVE BLANKS TO PAYRECORD BONDENOMINATION, GO TO BOND.END
221,00  SENTENCE  MOVE CORRESPONDING MASTER TO BONDORDER, ADD BONDORDER BONDENOMINATION TO INTERNAL.TOTALS BONDPURCHASES, MOVE BONDORDER BONDENOMINATION TO PAYRECORD BONDENOMINATION
222,00  SENTENCE  FILE BONDORDER
223,00  SENTENCE  BOND.END. END BOND.ROUTINE
224,00  SENTENCE  SEARCH. BEGIN SECTION
225,00  SENTENCE  IF MASTER RATE GT TABLE.ITEM RATE ( INDEX ) THEN GO TO SEARCH.END OTHERWISE MOVE INDEX TO POS, MOVE INSPREM ( POS ) TO INS.PREM, WORKING INSURANCE, MOVE RETPREM ( POS ) TO RET.PREM, WORKING RETIREMENT, GO TO NET
226,00  SENTENCE  SEARCH.END. END SEARCH
227,00  SENTENCE  DEPARTMENT.END. BEGIN SECTION
228,00  SENTENCE  MOVE CORRESPONDING INTERNAL.TOTALS TO DEPARTMENT.TOTAL, FILE DEPARTMENT.TOTAL, ADD CORRESPONDING INTERNAL.TOTALS TO GRAND.TOTALS
229,00  SENTENCE  END DEPARTMENT.END
