#!/bin/bash
# Keep text mirrors in step with staged canon decks (docs/design/deck-format.md
# §6). Enable with: git config core.hooksPath .githooks
set -e

command -v dart >/dev/null || { echo "pre-commit: dart not found on PATH" >&2; exit 1; }

staged=()
while IFS= read -r -d '' f; do staged+=("$f"); done \
  < <(git diff --cached --name-only -z --diff-filter=ACM -- '*.ctd')

# Handle renames: remove old mirror, regenerate at new path
while IFS= read -r -d '' _status && IFS= read -r -d '' old_file && IFS= read -r -d '' new_file; do
  old_mirror="${old_file%.ctd}.ct"
  git rm -q --cached --ignore-unmatch -- "$old_mirror"
  rm -f -- "$old_mirror"
  staged+=("$new_file")
done < <(git diff --cached --name-status -z --diff-filter=R -- '*.ctd')

deleted=()
while IFS= read -r -d '' f; do deleted+=("$f"); done \
  < <(git diff --cached --name-only -z --diff-filter=D -- '*.ctd')

# A deleted canon deck takes its mirror with it.
for f in ${deleted[@]+"${deleted[@]}"}; do
  m="${f%.ctd}.ct"
  git rm -q --cached --ignore-unmatch -- "$m"
  rm -f -- "$m"
done

[ ${#staged[@]} -eq 0 ] && exit 0

# Regeneration reads the working tree; refuse a half-staged canon file, whose
# mirror would not match the staged content.
for f in "${staged[@]}"; do
  if ! git diff --quiet -- "$f"; then
    echo "pre-commit: $f has unstaged changes; stage or stash them first" >&2
    exit 1
  fi
done

dart run comtran:deckconv regen "${staged[@]}"
for f in "${staged[@]}"; do
  git add -- "${f%.ctd}.ct"
done

dart run comtran:deckconv check .
